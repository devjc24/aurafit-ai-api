# Aura IA — variáveis de ambiente
# Copie para .env e ajuste os valores.

NODE_ENV=development
PORT=3000
SERVICE_NAME=Aura IA

# Ollama (obrigatórios)
OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen2.5-coder:3b

# Timeouts e limites
OLLAMA_TIMEOUT_MS=60000
MAX_PROMPT_LENGTH=16000

# CORS: * ou lista separada por vírgula
CORS_ORIGINS=*

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# M2M AuraHub → Aura IA
# Opcional no boot (health sobe sem ela). Obrigatória para /api/v1/ai quando
# M2M_AUTH_REQUIRED=true. Nunca compartilhar com SIA / AuraFit / CRM.
# ---------------------------------------------------------------------------
# AURA_HUB_M2M_API_KEY=change-me-hub-to-aura-ia-m2m
M2M_AUTH_REQUIRED=true

# Rate limit do hop Hub→IA
HUB_RATE_LIMIT_WINDOW_MS=60000
HUB_RATE_LIMIT_MAX=120
